		    #"Recode Alone to Single" = Table.ReplaceValue(#"Tipo cambiado","Alone","Single",Replacer.ReplaceValue,{"Marital_Status"}),
		    #"Recode YOLO to Other" = Table.ReplaceValue(#"Recode Alone to Single","YOLO","Other",Replacer.ReplaceValue,{"Marital_Status"}),
		    #"Recode Absurd to Other" = Table.ReplaceValue(#"Recode YOLO to Other","Absurd","Other",Replacer.ReplaceValue,{"Marital_Status"})
