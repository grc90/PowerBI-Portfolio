	partition Dim_Customer = m
		mode: import
		source =
				let
				    Origen = Stg_MarketingData_Clean,
				    // corte = p75 del gasto total (1045), sale del Excel original
				    #"Add Spend Tier" = Table.AddColumn(Origen, "Spend_Tier", each if [MntWines] + [MntFruits] + [MntMeatProducts] + [MntFishProducts] + [MntSweetProducts] + [MntGoldProds] > 1045 then "Top 25%" else "Rest", type text),
				    // deals sobre compras por canal (web+catalogo+tienda); >= 1/3 es el p75
				    #"Add Deal Shopper" = Table.AddColumn(#"Add Spend Tier", "Deal_Shopper", each let p = [NumWebPurchases] + [NumCatalogPurchases] + [NumStorePurchases] in if p = 0 then "No purchases" else if [NumDealsPurchases] / p >= 0.33 then "Deal-driven" else "Full price", type text),
				    #"Select Customer Attributes" = Table.SelectColumns(#"Add Deal Shopper",{"ID", "Education", "Marital_Status", "Income", "Kidhome", "Teenhome", "Dt_Customer", "Recency", "NumDealsPurchases", "NumWebVisitsMonth", "Complain", "Country", "Year_Birth", "Spend_Tier", "Deal_Shopper"}),
				    #"Rename Key and Date Columns" = Table.RenameColumns(#"Select Customer Attributes",{{"ID", "CustomerID"}, {"Dt_Customer", "Enrollment_Date"}}),
				    #"Add Age" = Table.AddColumn(#"Rename Key and Date Columns", "Age", each if [Year_Birth] = null then null else 2014 - [Year_Birth]),
				    #"Add Age Bucket" = Table.AddColumn(#"Add Age", "Age_Bucket", each if [Age] = null then "Unknown" else if [Age] <= 34 then "Young Adult" else if [Age] <= 54 then "Adult" else "Senior"),
				    #"Add Income Bucket" = Table.AddColumn(#"Add Age Bucket", "Income_Bucket", each if [Income] = null then "Unknown" else if [Income] < 35000 then "Low" else if [Income] <= 68000 then "Mid" else "High"),
				    #"Add Has Children Flag" = Table.AddColumn(#"Add Income Bucket", "Has_Children", each if [Kidhome] + [Teenhome] > 0 then "Yes" else "No"),
				    #"Add Bucket Sort" = Table.AddColumn(#"Add Has Children Flag", "Age_Bucket_Sort", each if [Age_Bucket] = "Young Adult" then 1 else if [Age_Bucket] = "Adult" then 2 else if [Age_Bucket] = "Senior" then 3 else 4),
				    #"Add Income Sort" = Table.AddColumn(#"Add Bucket Sort", "Income_Bucket_Sort", each if [Income_Bucket] = "Low" then 1 else if [Income_Bucket] = "Mid" then 2 else if [Income_Bucket] = "High" then 3 else 4),
				    #"Set Column Types" = Table.TransformColumnTypes(#"Add Income Sort",{{"CustomerID", Int64.Type}, {"Education", type text}, {"Marital_Status", type text}, {"Income", type number}, {"Kidhome", Int64.Type}, {"Teenhome", Int64.Type}, {"Enrollment_Date", type date}, {"Recency", Int64.Type}, {"NumDealsPurchases", Int64.Type}, {"NumWebVisitsMonth", Int64.Type}, {"Complain", Int64.Type}, {"Country", type text}, {"Year_Birth", Int64.Type}, {"Age", Int64.Type}, {"Age_Bucket", type text}, {"Income_Bucket", type text}, {"Has_Children", type text}, {"Age_Bucket_Sort", Int64.Type}, {"Income_Bucket_Sort", Int64.Type}, {"Spend_Tier", type text}, {"Deal_Shopper", type text}}),
				    #"Columnas reordenadas" = Table.ReorderColumns(#"Set Column Types",{"CustomerID", "Year_Birth", "Age", "Age_Bucket", "Education", "Marital_Status", "Income", "Income_Bucket", "Kidhome", "Teenhome", "Has_Children", "Country", "Enrollment_Date", "Recency", "Complain", "NumDealsPurchases", "Deal_Shopper", "Spend_Tier", "NumWebVisitsMonth", "Age_Bucket_Sort", "Income_Bucket_Sort"})
				in
				    #"Columnas reordenadas"

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

